# Generated data: corpus prefixes, query files, raw Wikipedia dumps (data/raw/)
data/*
!data/.gitkeep
# ...except the hand-made test data (tiny corpus, queries, expected canonical dump)
!data/tiny/

# Build outputs: every build.sh writes into impl/<lang>/<variant>/build/
build/

# Python
__pycache__/
.ipynb_checkpoints/
.venv/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Results (results/<experiment>/<timestamp>/): the final experiments are committed (results.tsv,
# meta.txt, failures.tsv, runlist.tsv, logs/) without the raw latency files, which are large and go
# to a GitHub release. Not committed: quick and dev runs, and results/full/ (a dress rehearsal,
# docs/design.md, section Layout).
results/quick/
results/dev/
results/full/
results/*/*/latencies/
